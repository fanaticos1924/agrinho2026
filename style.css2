/* Reset básico de margens e fontes */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #f4f7f4;
    color: #333;
    line-height: 1.6;
}

/* Cabeçalho e Navegação */
header {
    background-color: #ffffff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 10%;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo h2 {
    color: #2e7d32; /* Verde escuro */
}

.logo span {
    color: #81c784; /* Verde claro */
}

nav ul {
    list-style: none;
    display: flex;
}

nav ul li {
    margin-left: 20px;
}

nav ul li a {
    text-decoration: none;
    color: #555;
    font-weight: 600;
    transition: color 0.3s ease;
}

nav ul li a:hover {
    color: #2e7d32;
}

/* Seção Hero (Banner Principal) */
.hero {
    /* Imagem de fundo temática via Unsplash */
    background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=1200&q=80') no-repeat center center/cover;
    height: 60vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    padding: 0 20px;
}

.hero-content h1 {
    font-size: 3rem;
    margin-bottom: 15px;
}

.hero-content p {
    font-size: 1.2rem;
    max-width: 600px;
    margin: 0 auto 25px;
}

/* Botões Globais */
.btn {
    display: inline-block;
    background-color: #2e7d32;
    color: white;
    padding: 12px 30px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.btn:hover {
    background-color: #1b5e20;
}

/* Seções de Conteúdo Geral */
.content-section {
    padding: 80px 10%;
    text-align: center;
}

.content-section h2 {
    color: #2e7d32;
    margin-bottom: 20px;
    font-size: 2rem;
}

.content-section p {
    max-width: 800px;
    margin: 0 auto;
    font-size: 1.1rem;
    color: #666;
}

/* Seção de Práticas (Cards em Grid/Flexbox) */
.card-section {
    background-color: #e8f5e9; /* Fundo esverdeado suave */
}

.cards-container {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    margin-top: 40px;
    gap: 20px;
}

.card {
    background-color: white;
    padding: 30px;
    border-radius: 8px;
    width: 30%;
    min-width: 280px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
}

.card h3 {
    color: #1b5e20;
    margin-bottom: 15px;
}

.card p {
    font-size: 0.95rem;
    color: #555;
}

